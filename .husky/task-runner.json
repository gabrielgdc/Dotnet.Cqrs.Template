{
  "version": 1,
  "isRoot": true,
  "tasks": [
    {
      "name": "dotnet-format-staged-files",
      "group": "pre-commit-operations",
      "command": "dotnet",
      "args": [
        "format",
        "--include",
        "${staged}"
      ],
      "include": [
        "**/*.cs"
      ]
    }
  ]
}
